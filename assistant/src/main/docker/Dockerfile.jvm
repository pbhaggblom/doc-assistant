FROM maven:3.9.6-eclipse-temurin-21 AS build
WORKDIR /app

COPY pom.xml .
COPY common/pom.xml common/
COPY assistant/pom.xml assistant/

COPY common/src common/src
COPY assistant/src assistant/src

RUN mkdir -p cli documentation && \
    echo '<project><modelVersion>4.0.0</modelVersion><parent><groupId>org.pbhaggblom</groupId><artifactId>doc-assistant</artifactId><version>1.0.0-SNAPSHOT</version></parent><artifactId>cli</artifactId></project>' > cli/pom.xml && \
    echo '<project><modelVersion>4.0.0</modelVersion><parent><groupId>org.pbhaggblom</groupId><artifactId>doc-assistant</artifactId><version>1.0.0-SNAPSHOT</version></parent><artifactId>documentation</artifactId></project>' > documentation/pom.xml

RUN mvn install -DskipTests -pl common,assistant -am

FROM registry.access.redhat.com/ubi9/openjdk-21-runtime:1.24
WORKDIR /deployments

COPY --from=build --chown=185 /app/assistant/target/quarkus-app/lib/ /deployments/lib/
COPY --from=build --chown=185 /app/assistant/target/quarkus-app/*.jar /deployments/
COPY --from=build --chown=185 /app/assistant/target/quarkus-app/app/ /deployments/app/
COPY --from=build --chown=185 /app/assistant/target/quarkus-app/quarkus/ /deployments/quarkus/

EXPOSE 8080
EXPOSE 9000
USER 185

ENV JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"
ENV JAVA_APP_JAR="/deployments/quarkus-run.jar"

ENTRYPOINT [ "/opt/jboss/container/java/run/run-java.sh" ]